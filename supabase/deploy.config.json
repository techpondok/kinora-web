{
  "version": "2.0.0",
  "description": "Kinora Dual-Environment Deployment Configuration",

  "environments": {
    "development": {
      "project_ref": "YOUR_DEV_PROJECT_REF",
      "description": "Supabase Development — test data, sandbox payments",
      "payment_env": "sandbox",
      "fcm_env": "dev"
    },
    "production": {
      "project_ref": "sasigbuckngggpwpxlhz",
      "description": "Supabase Production — real users, live payments",
      "payment_env": "production",
      "fcm_env": "prod"
    }
  },

  "deployment_order": [
    "database_migrations",
    "rls_policies",
    "edge_function_secrets",
    "edge_functions",
    "storage_policies",
    "post_deployment_verification"
  ],

  "edge_functions": [
    {
      "name": "sumopod-webhook",
      "description": "Sumopod payment webhook handler",
      "verify_jwt": false,
      "required_secrets": [
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUMOPOD_WEBHOOK_SECRET",
        "SUMOPOD_WEBHOOK_TOKEN"
      ],
      "category": "payment"
    },
    {
      "name": "tripay-webhook",
      "description": "Tripay payment webhook handler",
      "verify_jwt": false,
      "required_secrets": [
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "TRIPAY_PRIVATE_KEY"
      ],
      "category": "payment"
    },
    {
      "name": "payment-create",
      "description": "Create payment transactions (Sumopod/Tripay)",
      "verify_jwt": true,
      "required_secrets": [
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "SUMOPOD_API_KEY",
        "SUMOPOD_API_URL"
      ],
      "category": "payment"
    },
    {
      "name": "verify-google-play",
      "description": "Google Play purchase verification for Family Plus",
      "verify_jwt": true,
      "required_secrets": [
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "GOOGLE_PLAY_SERVICE_ACCOUNT_KEY"
      ],
      "category": "subscription"
    },
    {
      "name": "send-notification",
      "description": "Push notification sender (FCM)",
      "verify_jwt": true,
      "required_secrets": [
        "SUPABASE_URL",
        "SUPABASE_SERVICE_ROLE_KEY",
        "FCM_SERVER_KEY"
      ],
      "category": "notification"
    }
  ],

  "secrets_per_environment": {
    "development": {
      "PAYMENT_ENV": "sandbox",
      "SUMOPOD_API_URL": "https://sandbox.sumopod.com",
      "notes": "Use sandbox/test keys for all payment and notification secrets"
    },
    "production": {
      "PAYMENT_ENV": "production",
      "SUMOPOD_API_URL": "https://api.sumopod.com",
      "notes": "Use live keys. Double-check before updating."
    }
  },

  "workflow": {
    "1_create": "Create migration SQL in supabase/migrations/",
    "2_deploy_dev": "npm run deploy:dev (or scripts/deploy-dev.bat)",
    "3_test": "Test with Admin Web Dev + Flutter Dev",
    "4_deploy_prod": "npm run deploy:prod (or scripts/deploy-production.bat)",
    "5_verify": "Verify in production dashboard"
  }
}
