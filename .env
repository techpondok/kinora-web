# ============================================================
# KINORA - BASE ENVIRONMENT (Fallback)
# ============================================================
# This is the base/fallback for Vite.
# npm run dev → overridden by .env.development
# npm run build → overridden by .env.production
#
# If you're getting credential errors, make sure .env.development
# has your Supabase DEV project URL and anon key.

VITE_APP_ENV=development
