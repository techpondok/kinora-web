{
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap.xml"
    },
    {
      "source": "/robots.txt",
      "destination": "/api/robots.txt"
    },
    {
      "source": "/ads.txt",
      "destination": "/api/ads.txt"
    },
    {
      "source": "/api/payments/tripay/callback",
      "destination": "/api/payments/tripay/callback"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}